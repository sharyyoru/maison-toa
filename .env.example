# Swiss medical billing (MediData proxy on Railway)
# MEDIDATA_PROXY_URL = the Railway URL for the medidata-proxy service
# MEDIDATA_PROXY_API_KEY = shared secret (x-api-key header)
# MEDIDATA_PROXY_PATH_PREFIX = route prefix for THIS tenant's medidata routes
#   aestheticclinic: /api/medidata  (default, omit this var)
#   maison-toa:      /api/maison    (set this in Vercel dashboard)
MEDIDATA_PROXY_URL=https://medidata-proxy-production.up.railway.app
MEDIDATA_PROXY_API_KEY=your-medidata-proxy-api-key
MEDIDATA_PROXY_PATH_PREFIX=/api/maison

# Sumex1 invoice server (Windows VM running the Sumex REST servers)
SUMEX_INVOICE_REQUEST_URL=http://YOUR_VM_IP:8080/generalInvoiceRequestManagerServer500
SUMEX_INVOICE_RESPONSE_URL=http://YOUR_VM_IP:8080/generalInvoiceResponseManagerServer500

# Sumex ACF/TMA validator
SUMEX_ACF_URL=http://YOUR_VM_IP:8081/acfValidatorServer100

# Sumex TARDOC validator
SUMEX_TARDOC_URL=http://YOUR_VM_IP:8082/tardocValidatorServer100
