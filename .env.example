# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key for secure server-side operations only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Email service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=info@mail.example.com
EMAIL_FROM_NAME=Maison Toa
EMAIL_REPLY_DOMAIN=example.com

# Cron job authentication (REQUIRED - generate a random secret)
CRON_SECRET=your-random-cron-secret

# Payment providers
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
PAYREXX_API_SECRET=your-payrexx-api-secret
